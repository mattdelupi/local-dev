#!/usr/bin/env bash

set -e

mkdir -p .local/bin .local/opt .local/share/fonts .config

nerd_font_version="v3.5.1"
curl -4 -fL -O https://github.com/ryanoasis/nerd-fonts/releases/download/"$nerd_font_version"/JetBrainsMono.zip
unzip -o JetBrainsMono.zip -d .local/share/fonts
rm JetBrainsMono.zip

curl -fL -O https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz
tar xzvf nvim-linux-x86_64.tar.gz
rm nvim-linux-x86_64.tar.gz
rm -rf .local/opt/nvim
mv nvim-linux-x86_64 .local/opt/nvim
ln -sfn ../opt/nvim/bin/nvim .local/bin/nvim

fzf_version="0.75.0"
curl -fL -O https://github.com/junegunn/fzf/releases/download/v0.75.0/fzf-"$fzf_version"-linux_amd64.tar.gz
tar xzvf fzf-"$fzf_version"-linux_amd64.tar.gz
rm fzf-"$fzf_version"-linux_amd64.tar.gz
mv fzf .local/bin/

rg_version="15.2.0"
curl -fL -O https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-"$rg_version"-x86_64-unknown-linux-musl.tar.gz
tar xzvf ripgrep-"$rg_version"-x86_64-unknown-linux-musl.tar.gz
rm ripgrep-"$rg_version"-x86_64-unknown-linux-musl.tar.gz
rm -rf .local/opt/rg
mv ripgrep-"$rg_version"-x86_64-unknown-linux-musl .local/opt/rg
ln -sfn ../opt/rg/rg .local/bin/rg

fd_version="v10.5.2"
curl -fL -O https://github.com/sharkdp/fd/releases/download/v10.5.2/fd-"$fd_version"-x86_64-unknown-linux-gnu.tar.gz
tar xzvf fd-"$fd_version"-x86_64-unknown-linux-gnu.tar.gz
rm fd-"$fd_version"-x86_64-unknown-linux-gnu.tar.gz
rm -rf .local/opt/fd
mv fd-"$fd_version"-x86_64-unknown-linux-gnu .local/opt/fd
ln -sfn ../opt/fd/fd .local/bin/fd
